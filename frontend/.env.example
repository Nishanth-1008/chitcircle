# --- Live API (optional). Without these the app runs in clearly-labelled Demo mode only. ---
# Server-side only: where the FastAPI financial engine is running. Never exposed to the browser.
CHITCIRCLE_API_URL=http://localhost:8000
# Enables the "live API" option in the UI (the browser calls same-origin /api/backend/*).
NEXT_PUBLIC_LIVE_API_ENABLED=true
# Used ONLY when an API response does not carry a currency code. The UI marks such amounts as "assumed".
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
# "stub" (default) keeps the "payout gateway is not connected" notices on. Set to "live" only after a verified
# provider integration exists.
NEXT_PUBLIC_PAYOUT_GATEWAY=stub
