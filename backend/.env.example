# Database (PostgreSQL 16 in production; SQLite for local dev/tests)
# Copy to .env and fill in real values before running locally or deploying.
DATABASE_URL=postgresql+psycopg://chitcircle:chitcircle@localhost:5432/chitcircle

# Shared secret used to verify signed provider callbacks (HMAC-SHA256 of the raw body in X-Signature).
# If unset, every callback is rejected. Required in production.
WEBHOOK_SECRET=change-me-in-production

# PayPal Sandbox Credentials (get from https://developer.paypal.com/dashboard/)
# Production: use api-m.paypal.com and live credentials.
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your-webhook-id

# JWT Configuration — no insecure default; must be set explicitly (the placeholder below is rejected).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The web client refreshes tokens 5 minutes before expiry.
JWT_SECRET_KEY=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Payments: "paypal" is used automatically when PAYPAL_CLIENT_ID is set; force the in-memory mock with "mock".
# Note: PayPal Invoicing does not accept INR, and Payouts must be enabled on the sandbox app.
PAYMENT_GATEWAY=
# Where the web app lives (PayPal return/cancel URLs).
APP_BASE_URL=http://localhost:3000
# Sandbox tools simulate provider confirmations locally (always off when APP_ENV=production).
SANDBOX_TOOLS=true
# Print every OpenTelemetry span to stdout (noisy; local debugging only).
OTEL_CONSOLE_EXPORT=false

# Redis (PayPal OAuth token cache + rate limiting)
REDIS_URL=redis://localhost:6379/0

# Runtime environment: development | test | staging | production
APP_ENV=development
# The X-Actor-Id / X-Actor-Role development stub: test + local web client only, never production.
ALLOW_ACTOR_HEADERS=true
# Feature switches: kill switches for agent proposal / mandate execution.
AGENT_PROPOSAL_ENABLED=true
AGENT_EXECUTION_ENABLED=true

# PII encryption key for user_contacts.value (Fernet). Required to save PayPal emails.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=base64-encoded-32-byte-key

# Read replica URL for read endpoints (optional; production only).
# Leave empty to use the primary DATABASE_URL for all reads.
READ_REPLICA_DATABASE_URL=